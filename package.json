{
  "name": "monitor-smith",
  "private": true,
  "version": "1.0.0",
  "description": "MonitorSmith — ferramentas de inspeção visual, iluminação e produtividade para monitores, por EXVORN.TECH.",
  "license": "UNLICENSED",
  "homepage": "https://monitorsmith.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/arch-antomcore/monitorsmith.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo-pages.mjs && node scripts/generate-service-worker.mjs && node scripts/validate-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:build": "node scripts/validate-build.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "validate": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lenis": "^1.3.25",
    "motion": "^12.43.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
